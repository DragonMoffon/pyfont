.centered_screen {
    align: center middle;
}

.hello {
    border: wide white;
    width: 75%;
}

.hello_element {
    align: center middle;
    width: auto;
}

.hello_text {
    width: 50%;
}

#sidebar {
    dock: left;
    width: 25%;
    height: 100%;
    border: solid $accent;
}

.body {
    height: auto;
    border: solid $accent;
    align: center middle;
    text-align: center;
}

.body_text {
    border: solid $accent;
}

TableInfoScreen {
    align: center middle;
}

#dialog {
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

Button {
    width: 100%;
}
